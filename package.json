{
  "name": "frigolog-mcp",
  "version": "3.0.0",
  "description": "Public MCP server exposing French HACCP regulatory data and a comparison of HACCP software solutions on the French market. Built for AI agents (Claude, ChatGPT, Perplexity) to give accurate, sourced answers about food safety in France.",
  "private": false,
  "mcpName": "io.github.naimterrache-a11y/frigolog-haccp",
  "license": "MIT",
  "type": "module",
  "homepage": "https://frigolog.fr",
  "repository": {
    "type": "git",
    "url": "https://github.com/naimterrache-a11y/frigolog-mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "haccp",
    "food-safety",
    "france",
    "ddpp",
    "frigolog"
  ],
  "files": [
    "api",
    "lib",
    "data",
    "public",
    "server.json",
    "vercel.json",
    "tsconfig.json",
    "!lib/prive",
    "!scripts"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vercel dev",
    "build": "tsc --noEmit",
    "test": "node tests/mcp.test.js",
    "deploy": "vercel --prod",
    "test:prive": "node tests/prive.test.mjs",
    "preuve:isolation": "node scripts/preuve-isolation.mjs",
    "export:gpt": "node scripts/export-connaissance-gpt.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vercel/node": "^3.0.0",
    "typescript": "^5.3.0"
  }
}
